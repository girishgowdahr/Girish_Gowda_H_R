{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://girish.dev/schemas/portfolio-content.schema.json",
  "title": "PortfolioContentImport",
  "description": "Validation schema for owner-supplied portfolio profile and resume data bundle.",
  "type": "object",
  "required": [
    "contentVersion",
    "source",
    "rules",
    "profile",
    "contacts",
    "education",
    "skills",
    "projects",
    "publications",
    "certificates",
    "achievements",
    "experience",
    "keyStrengths",
    "ownerQuestionsOpen"
  ],
  "additionalProperties": false,
  "properties": {
    "contentVersion": { "type": "integer", "minimum": 1 },
    "source": { "type": "string" },
    "rules": {
      "type": "object",
      "required": ["publishOnlyIfStatus", "unconfirmedNeverPublished"],
      "additionalProperties": false,
      "properties": {
        "publishOnlyIfStatus": {
          "type": "array",
          "items": { "type": "string" }
        },
        "unconfirmedNeverPublished": { "type": "boolean" },
        "phoneNumber": { "type": "string" }
      }
    },
    "profile": {
      "type": "object",
      "required": ["id", "status", "visibility", "displayName", "headline", "location", "languages", "summary", "careerGoal"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string" },
        "status": { "type": "string" },
        "visibility": { "type": "string" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 128 },
        "headline": { "type": "string", "minLength": 1, "maxLength": 255 },
        "location": { "type": "string", "maxLength": 128 },
        "languages": { "type": "array", "items": { "type": "string" } },
        "summary": { "type": "string" },
        "careerGoal": { "type": "string" },
        "availabilityStatus": { "type": ["string", "null"] }
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "status", "visibility"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "value": { "type": ["string", "null"] },
          "status": { "type": "string" },
          "visibility": { "type": "string" },
          "note": { "type": "string" }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "level", "institution", "city", "status", "visibility", "sortOrder"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "level": { "type": "string" },
          "institution": { "type": "string" },
          "city": { "type": "string" },
          "start": { "type": ["string", "null"] },
          "end": { "type": ["string", "null"] },
          "endIsExpected": { "type": "boolean" },
          "inProgress": { "type": "boolean" },
          "score": {
            "type": ["object", "null"],
            "properties": {
              "type": { "type": "string" },
              "value": { "type": "number" },
              "outOf": { "type": "number" }
            },
            "required": ["type", "value", "outOf"]
          },
          "status": { "type": "string" },
          "visibility": { "type": "string" },
          "sortOrder": { "type": "integer" }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "group", "items", "status", "visibility", "sortOrder"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "group": { "type": "string" },
          "items": { "type": "array", "items": { "type": "string" } },
          "status": { "type": "string" },
          "visibility": { "type": "string" },
          "sortOrder": { "type": "integer" }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "start", "end", "bullets", "technologies", "status", "visibility", "sortOrder"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "kind": { "type": "string" },
          "start": { "type": "string" },
          "end": { "type": "string" },
          "bullets": { "type": "array", "items": { "type": "string" } },
          "technologies": { "type": "array", "items": { "type": "string" } },
          "links": { "type": "array" },
          "repoUrl": { "type": ["string", "null"] },
          "demoUrl": { "type": ["string", "null"] },
          "status": { "type": "string" },
          "visibility": { "type": "string" },
          "sortOrder": { "type": "integer" }
        }
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "publisher", "year", "state", "role", "abstractSummary", "status", "visibility", "sortOrder"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "publisher": { "type": "string" },
          "year": { "type": "string" },
          "state": { "type": "string" },
          "role": { "type": "string" },
          "abstractSummary": { "type": "string" },
          "doi": { "type": ["string", "null"] },
          "url": { "type": ["string", "null"] },
          "conference": { "type": ["string", "null"] },
          "status": { "type": "string" },
          "visibility": { "type": "string" },
          "missingFields": { "type": "array", "items": { "type": "string" } },
          "sortOrder": { "type": "integer" }
        }
      }
    },
    "certificates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "issuer", "status", "visibility", "sortOrder"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "issuer": { "type": "string" },
          "issueDate": { "type": ["string", "null"] },
          "credentialId": { "type": ["string", "null"] },
          "media": { "type": ["string", "null"] },
          "description": { "type": ["string", "null"] },
          "status": { "type": "string" },
          "visibility": { "type": "string" },
          "missingFields": { "type": "array", "items": { "type": "string" } },
          "sortOrder": { "type": "integer" }
        }
      }
    },
    "achievements": { "type": "array" },
    "experience": { "type": "array" },
    "keyStrengths": { "type": "array", "items": { "type": "string" } },
    "ownerQuestionsOpen": { "type": "array", "items": { "type": "string" } }
  }
}
