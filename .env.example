# ==============================================================================
# GIRISH Monorepo Environment Variables Example
# RULE: VARIABLE NAMES ONLY - NO SECRETS OR SENSITIVE VALUES IN THIS FILE
# ==============================================================================

# Server Profile & Port Configuration
SERVER_PORT=
SPRING_PROFILES_ACTIVE=

# Database Connection (PostgreSQL)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# Security & CORS
APP_SESSION_COOKIE_NAME=
APP_SESSION_COOKIE_DOMAIN=
APP_SESSION_SECURE=
APP_CORS_ALLOWED_ORIGINS=

# Object Storage / S3-compatible (MinIO / Cloudflare R2 / Backblaze)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_BUCKET_VAULT=

# Mail / Notifications (Alerts only)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=

# Frontend Public API URL (Vite client)
VITE_API_BASE_URL=
