# ==============================================================================
# GIRISH Monorepo .gitignore
# ==============================================================================

# OS & Environment
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~

# IDEs & Editors
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# Environment & Secrets (NEVER COMMIT SECRETS)
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.pkcs12
*.p12
*.jks
*.keystore
secrets/
private-keys/

# Logs & Diagnostics
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node / Frontend
node_modules/
dist/
dist-ssr/
build/
.cache/
.vite/
.turbo/
coverage/
*.lcov
.eslintcache

# Java / Spring Boot / Maven / Gradle
target/
*.class
.mvn/.extracted/
backend/.mvn/wrapper/maven-wrapper.jar
.gradle/
build/
out/
bin/
*.jar
*.war
*.ear

# Testing & Reports
test-results/
playwright-report/
blob-report/
playwright/.cache/

# 3D / Blender temporary and backup files
*.blend1
*.blend2
*.blend@
*.autosave
raw-scans/
tmp-exports/

# Local database and storage data
infrastructure/docker/data/
postgres-data/
minio-data/
mailhog-data/

# Tools & Temporary scratchpads
tmp/
temp/
scratch/
